{
  "name": "aquawise-motion-trailer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AquaWiseTrailer out/aquawise-trailer.mp4",
    "render:silent": "remotion render src/index.ts AquaWiseTrailerSilent out/aquawise-trailer-silent.mp4",
    "poster": "remotion still src/index.ts AquaWiseTrailer out/aquawise-poster.png --frame=2190",
    "audio": "node scripts/generate-ambient.mjs && node scripts/generate-voiceover.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "node-edge-tts": "^1.2.10",
    "typescript": "^5.5.3"
  }
}
