# Base URL of the AquaWise GIS backend (file upload + demo-request endpoints).
# Local dev default is http://localhost:8000 (see api.ts).
# On Vercel, set this to your deployed backend URL, e.g. https://api.aquawise.example
VITE_API_URL=http://localhost:8000

# Google Maps tile key for the GIS workspace basemap (the "Map" basemap mode).
# Optional — when unset, the workspace falls back to CARTO basemap tiles, and
# the "No basemap" engineering-canvas mode always works without any key.
# Create a key at https://console.cloud.google.com/google/maps-apis with the
# "Map Tiles" / Maps JavaScript API enabled, then restrict it to your domains.
VITE_GOOGLE_MAPS_API_KEY=
